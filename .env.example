# ---- reverse image search (get at least SERPAPI_KEY; the others are fallbacks) ----
# https://serpapi.com  — 250 searches/month free, email + SMS verification
SERPAPI_KEY=
# https://www.searchapi.io — 100 free, email only (Google Lens fallback)
SEARCHAPI_KEY=
# https://serper.dev — 2500 free, email only (name-search fallback, hop 2)
SERPER_KEY=

# ---- chain ----
# local | base-sepolia | sepolia
CHAIN=base-sepolia
# Base Sepolia (chainId 84532)
RPC_URL=https://sepolia.base.org
RPC_URL_FALLBACK=https://base-sepolia-rpc.publicnode.com
# Throwaway burner key, testnet funds ONLY. Generate with:
#   python -m faceanchor newkey
PRIVATE_KEY=
# Optional: overrides deployments/<chain>.json
CONTRACT_ADDRESS=

# ---- optional ----
# https://app.pinata.cloud — pins the evidence bundle to IPFS, CID goes on-chain
PINATA_JWT=

# ---- tuning ----
FACE_ENGINE=insightface
MATCH_THRESHOLD=0.40
WEAK_THRESHOLD=0.30
