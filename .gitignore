# secrets — NEVER commit
.env
*.pem
*.key

# python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# ...but the compiled contract artifacts ARE committed: CI then needs no
# solc download, and viaIR compilation is slow.
!contracts/build/
!contracts/build/*.json

# models (large, downloaded on first run)
models/*.onnx
models/*.zip

# biometric material — must never leave the machine
evidence/**/face_secret.json
evidence/**/embedding.npy
evidence/**/post_embedding.npy
evidence/**/zk_secret.json

# runtime evidence (only evidence/demo/ is committed, force-added)
evidence/runs/

# cached provider responses and dashboard uploads
.cache/

# node / ui
ui/node_modules/
ui/dist/
ui/.vite/

# os
Thumbs.db
.DS_Store
desktop.ini

# Internal working notes, not deliverables. The build brief, the operator setup
# checklist and the team worklist are how the project was made, not what it is.
# They stay on disk; the code, tests, evidence and stated limitations are the
# submission.
MASTER_PROMPT.md
SETUP_CHECKLIST.md
docs/TEAM_TASKS.md
